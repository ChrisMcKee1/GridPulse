{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "gridpulse-db": "Host=localhost;Port=5432;Database=gridpulse;Username=postgres;Password=postgres"
  },
  "UtilitySampleData": {
    "Enabled": true,
    "IncludeScenarios": [
      "VehicleCollision",
      "StormDamage",
      "NewConstruction",
      "BuildingDemo",
      "EquipmentFailure",
      "UndergroundFault",
      "Wildlife",
      "ThirdPartyDamage"
    ],
    "CrewCount": 10,
    "ServiceTerritories": [ "North", "South", "East", "West", "Central" ],
    "TelemetryStaleness": "00:05:00"
  },
  "TicketAutomation": {
    "PollInterval": "00:00:05",
    "OutageBatchSize": 25,
    "MaxOutageAge": "12:00:00",
    "ProcessedRetention": "01:00:00"
  },
  "Authentication": {
    "Provider": "Mock",
    "Mock": {
      "DisplayName": "Auto Operator",
      "Roles": [
        "operator",
        "dispatcher"
      ],
      "Claims": {
        "tenant": "default",
        "scope": "ticketing"
      }
    }
  }
}
