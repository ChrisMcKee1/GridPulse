{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "gridpulse-db": "Host=localhost;Port=5432;Database=gridpulse;Username=postgres;Password=postgres"
  },
  "SampleData": {
    "RootPath": "sample-data",
    "OutagesFile": "outages/outages.csv",
    "OutageEventsFile": "outages/outage-events.csv"
  },
  "TicketSeed": {
    "TargetTicketCount": 16,
    "CrewCount": 10,
    "TelemetryCadence": "00:01:00"
  },
  "Authentication": {
    "Provider": "Mock",
    "Mock": {
      "DisplayName": "Auto Operator (Dev)",
      "Roles": [
        "operator",
        "dispatcher"
      ],
      "Claims": {
        "tenant": "dev",
        "scope": "ticketing"
      }
    }
  }
}
