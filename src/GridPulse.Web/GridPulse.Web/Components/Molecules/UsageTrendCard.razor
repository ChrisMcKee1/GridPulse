@using GridPulse.Web.Components.Molecules.Models
@using Radzen.Blazor

<RadzenCard Class="usage-card">
    <div class="usage-card__header">
        <div>
            <RadzenLabel Text="Usage" Style="font-size: 0.8rem; text-transform: uppercase;" />
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H4">@Title</RadzenText>
        </div>
        <RadzenText TextStyle="TextStyle.Body2">@DateRange</RadzenText>
    </div>
    <RadzenChart Style="height: 280px; width: 100%;">
        <RadzenLineSeries Data="@Data"
                          CategoryProperty="Date"
                          Title="Usage"
                          LineType="LineType.Solid"
                          Smooth="true"
                          Stroke="#2563EB"
                          StrokeWidth="3"
                          ValueProperty="KilowattHours">
            <RadzenMarkers MarkerType="MarkerType.Circle" Fill="#2563EB" Size="6" />
            <RadzenSeriesDataLabels Visible="false" />
        </RadzenLineSeries>
        <RadzenCategoryAxis Padding="20">
            <RadzenGridLines Visible="true" LineType="LineType.Solid" />
            <RadzenAxisTitle Text="" />
        </RadzenCategoryAxis>
        <RadzenValueAxis Formatter="@FormatAsKilowatt">
            <RadzenGridLines Visible="true" LineType="LineType.Solid" />
            <RadzenAxisTitle Text="kWh" />
        </RadzenValueAxis>
        <RadzenLegend Visible="false" />
    </RadzenChart>
</RadzenCard>

@code {
    [Parameter] public string Title { get; set; } = "Demand";
    [Parameter] public string DateRange { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<UsageTrendPoint> Data { get; set; } = Array.Empty<UsageTrendPoint>();

    string FormatAsKilowatt(object value)
    {
        return $"{value:N0} kWh";
    }
}
