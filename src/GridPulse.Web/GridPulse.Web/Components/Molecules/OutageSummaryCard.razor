@using GridPulse.Web.Services.Models

<RadzenCard Class="outage-card">
    <div class="outage-card__header">
        <div>
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H4">@Outage.ServiceAddress</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">@Outage.ReportedAt.ToLocalTime().ToString("f")</RadzenText>
        </div>
        <StatusChip Label="@Outage.Status" Variant="@StatusVariant" />
    </div>
    <div class="outage-card__body">
        <div>
            <RadzenLabel Text="ETA" Style="font-size: 0.8rem; text-transform: uppercase;" />
            <RadzenText TextStyle="TextStyle.Subtitle1">@EtaText</RadzenText>
        </div>
        <div>
            <RadzenLabel Text="Affected" Style="font-size: 0.8rem; text-transform: uppercase;" />
            <RadzenText TextStyle="TextStyle.Subtitle1">@Outage.AffectedCustomers</RadzenText>
        </div>
        <div>
            <RadzenLabel Text="Cause" Style="font-size: 0.8rem; text-transform: uppercase;" />
            <RadzenText TextStyle="TextStyle.Subtitle1">@(Outage.Cause ?? "Investigating")</RadzenText>
        </div>
    </div>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public OutageSummaryResponse Outage { get; set; } = default!;

    private string EtaText => Outage.EstimatedRestoration?.ToLocalTime().ToString("t") ?? "TBD";

    private string StatusVariant => Outage.Status switch
    {
        "Resolved" => "success",
        "CrewDispatched" => "warning",
        "Acknowledged" => "info",
        _ => "default"
    };
}
