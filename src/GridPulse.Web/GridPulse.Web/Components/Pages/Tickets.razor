@page "/tickets"
@rendermode InteractiveServer
@using System.Collections.Generic
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using GridPulse.Application.Models
@using GridPulse.Domain.Enums
@using GridPulse.Web.Services
@using Microsoft.Extensions.Logging
@using Radzen
@inject GridPulseApiClient ApiClient
@inject NotificationService NotificationService
@inject ILogger<Tickets> Logger
@implements IDisposable

<RadzenStack Gap="1.5rem" class="tickets-page">
	<!-- Hero Header -->
	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.75rem">
		<div>
			<h1 data-testid="tickets-heading" style="margin: 0; font-size: 2.5rem;">Ticket Management</h1>
			<p class="tickets-subtitle">Monitor outage tickets, review duplicates, and advance workflow states</p>
		</div>

		<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
			<RadzenButton Icon="refresh" 
						  Variant="Variant.Outlined"
						  Click="async () => await LoadTicketsAsync()" 
						  Disabled="@isLoading" 
						  data-testid="tickets-refresh">
				Refresh
			</RadzenButton>
			<RadzenButton Icon="add_circle" 
						  ButtonStyle="ButtonStyle.Primary"
						  Variant="Variant.Flat"
						  Click="ToggleCreatePanel" 
						  data-testid="tickets-new">
				New Ticket
			</RadzenButton>
		</RadzenStack>
	</RadzenStack>

	@if (!string.IsNullOrEmpty(errorMessage))
	{
		<RadzenAlert AlertStyle="AlertStyle.Danger" 
					 Variant="Variant.Flat"
					 Shade="Shade.Lighter"
					 Closeable="true" 
					 Text="@errorMessage" />
	}

	<!-- Filters Card with Glass Effect -->
	<RadzenCard class="tickets-filters-card gp-glass">
		<RadzenStack Gap="0.75rem">
			<RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
				<RadzenStack Gap="0.5rem" Style="min-width: 200px;">
					<label class="tickets-filter-label">Status</label>
					<RadzenDropDown Data="@statusOptions" 
								   TItem="DropdownOption<TicketStatus>" 
								   TValue="IEnumerable<TicketStatus>" 
								   ValueProperty="Value" 
								   TextProperty="Label"
								   Multiple="true" 
								   AllowClear="true" 
								   Chips="true"
								   Style="width: 100%;"
								   @bind-Value="StatusFilter" 
								   Change="async _ => await ApplyFiltersAsync()" />
				</RadzenStack>
				<RadzenStack Gap="0.5rem" Style="min-width: 180px;">
					<label class="tickets-filter-label">Minimum Priority</label>
					<RadzenDropDown Data="@priorityOptions" 
								   TItem="DropdownOption<TicketPriority>" 
								   TValue="TicketPriority?" 
								   ValueProperty="Value" 
								   TextProperty="Label"
								   AllowClear="true" 
								   Placeholder="Any" 
								   Style="width: 100%;"
								   @bind-Value="minPriority" 
								   Change="async _ => await ApplyFiltersAsync()" />
				</RadzenStack>
				<RadzenStack Gap="0.5rem">
					<label class="tickets-filter-label">Include Timeline</label>
					<RadzenSwitch @bind-Value="includeTimeline" Change="async _ => await ApplyFiltersAsync()" />
				</RadzenStack>
				<RadzenStack Gap="0.5rem">
					<label class="tickets-filter-label">Include Recommendations</label>
					<RadzenSwitch @bind-Value="includeRecommendations" Change="async _ => await ApplyFiltersAsync()" />
				</RadzenStack>
			</RadzenStack>
		</RadzenStack>
	</RadzenCard>

		@if (isCreatePanelOpen)
		{
			<hr class="tickets-divider" />
			<RadzenTemplateForm TItem="TicketCreateFormModel" Data="@createModel" Submit="CreateTicketAsync">
				<DataAnnotationsValidator />
				<RadzenStack Gap="12px" class="tickets-create-form">
					<RadzenAlert AlertStyle="@(AlertStyle.Info)" Text="New tickets will automatically run duplicate detection against existing outages." />
					<ValidationSummary class="validation-summary" />
					<RadzenRow Gap="1rem">
						<RadzenColumn Size="12" SizeMD="6">
							<RadzenStack Gap="0.25rem">
								<RadzenTextBox @bind-Value="createModel.Title" Name="Title" Placeholder="Ticket title" Style="width:100%" aria-label="Ticket title" />
								<ValidationMessage For="@(() => createModel.Title)" />
							</RadzenStack>
						</RadzenColumn>
						<RadzenColumn Size="12" SizeMD="6">
							<RadzenStack Gap="0.25rem">
								<RadzenTextBox @bind-Value="createModel.OutageReferenceId" Name="OutageReferenceId" Placeholder="Outage reference" Style="width:100%" aria-label="Outage reference" />
								<ValidationMessage For="@(() => createModel.OutageReferenceId)" />
							</RadzenStack>
						</RadzenColumn>
						<RadzenColumn Size="12" SizeMD="6">
							<RadzenStack Gap="0.25rem">
								<RadzenDropDown Data="@priorityOptions" TItem="DropdownOption<TicketPriority>" TValue="TicketPriority" ValueProperty="Value" TextProperty="Label"
												Style="width:100%" @bind-Value="createModel.Priority" Name="Priority" aria-label="Priority" />
								<ValidationMessage For="@(() => createModel.Priority)" />
							</RadzenStack>
						</RadzenColumn>
						<RadzenColumn Size="12" SizeMD="6">
							<RadzenStack Gap="0.25rem">
								<RadzenNumeric TValue="int" @bind-Value="createModel.CustomerImpact" Min="0" Style="width:100%" Placeholder="Impacted customers" Name="CustomerImpact" aria-label="Customer impact" />
								<ValidationMessage For="@(() => createModel.CustomerImpact)" />
							</RadzenStack>
						</RadzenColumn>
					</RadzenRow>
					<RadzenStack Gap="0.25rem">
						<RadzenTextArea @bind-Value="createModel.Description" Rows="3" Placeholder="Notes for dispatchers" Style="width:100%" Name="Description" aria-label="Description" />
						<ValidationMessage For="@(() => createModel.Description)" />
					</RadzenStack>
					<RadzenStack Gap="0.25rem">
						<RadzenTextBox @bind-Value="createModel.AssetsInput" Placeholder="Affected assets (comma separated)" Style="width:100%" Name="AssetsInput" aria-label="Affected assets" />
						<ValidationMessage For="@(() => createModel.AssetsInput)" />
					</RadzenStack>
					<RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
						<RadzenButton ButtonType="ButtonType.Submit" Icon="check" Disabled="@isSavingTicket" data-testid="tickets-create-submit">@(isSavingTicket ? "Creating..." : "Create ticket")</RadzenButton>
						<RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" Click="CancelCreatePanel" Disabled="@isSavingTicket" data-testid="tickets-create-cancel">Cancel</RadzenButton>
					</RadzenStack>
				</RadzenStack>
			</RadzenTemplateForm>
		}

	<RadzenSplitter Orientation="Orientation.Horizontal" Style="height: calc(100vh - 280px);">
		<!-- Left Pane: Ticket Grid -->
		<RadzenSplitterPane Size="40%" Min="30%" Max="50%">
			<RadzenCard class="tickets-grid-card" Style="height: 100%; display: flex; flex-direction: column;">
				<div data-testid="tickets-grid" Style="flex: 1; min-height: 0; overflow-y: auto;">
					@if (isLoading)
					{
						<RadzenSkeleton Lines="8" />
					}
					else if (tickets.Count == 0)
					{
						<p>No tickets match the selected filters.</p>
					}
					else
					{
						<RadzenDataGrid TItem="TicketDto" Data="tickets" AllowSorting="true" AllowPaging="true" PageSize="10" RowSelect="OnTicketSelected">
							<Columns>
								<RadzenDataGridColumn TItem="TicketDto" Property="Title" Title="Title" />
								<RadzenDataGridColumn TItem="TicketDto" Title="Status">
									<Template Context="item">
										<StatusChip Label="@item.Status.ToString()" Variant="@GetStatusVariant(item.Status)" />
									</Template>
								</RadzenDataGridColumn>
								<RadzenDataGridColumn TItem="TicketDto" Property="Priority" Title="Priority" />
								<RadzenDataGridColumn TItem="TicketDto" Title="Customers">
									<Template Context="item">@item.CustomerImpact</Template>
								</RadzenDataGridColumn>
								<RadzenDataGridColumn TItem="TicketDto" Title="Updated">
									<Template Context="item">@item.UpdatedAt.ToLocalTime().ToString("g")</Template>
								</RadzenDataGridColumn>
							</Columns>
						</RadzenDataGrid>
					}
				</div>
			</RadzenCard>
		</RadzenSplitterPane>

		<!-- Right Pane: Details & Timeline -->
		<RadzenSplitterPane>
			@if (selectedTicket is null)
			{
				<RadzenCard class="tickets-detail-card" Style="height: 100%; display: flex; align-items: center; justify-content: center;">
					<RadzenText TextStyle="TextStyle.Body1">Select a ticket to inspect details and the activity timeline.</RadzenText>
				</RadzenCard>
			}
			else
			{
				<RadzenStack Gap="1rem" Style="height: 100%; padding: 0.5rem; overflow-y: auto;">
					<!-- Ticket Details Card -->
					<RadzenCard class="tickets-detail-card">
						<RadzenStack Gap="1rem">
							<!-- Header -->
							<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Wrap="FlexWrap.Wrap" Gap="0.5rem">
								<RadzenStack Gap="0.25rem" Style="flex: 1; min-width: 200px;">
									<RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">@selectedTicket.Title</RadzenText>
									<RadzenText TextStyle="TextStyle.Body2" Class="tickets-detail-subtitle">Outage reference @selectedTicket.OutageReferenceId</RadzenText>
								</RadzenStack>
								<div data-testid="ticket-status-value">
									<StatusChip Label="@selectedTicket.Status.ToString()" Variant="@GetStatusVariant(selectedTicket.Status)" />
								</div>
							</RadzenStack>

							<!-- Duplicate Warning -->
							@if (ShowDuplicateWarning(selectedTicket))
							{
								<div data-testid="duplicate-alert">
									<RadzenAlert AlertStyle="@(AlertStyle.Warning)" Text="Possible duplicate outage detected within the last 5 minutes." />
								</div>
							}

							<!-- Metadata Grid - 2 Columns -->
							<RadzenRow Gap="0.75rem">
								<RadzenColumn Size="6">
									<RadzenStack Gap="0.25rem">
										<RadzenText TextStyle="TextStyle.Overline">Priority</RadzenText>
										<RadzenText TextStyle="TextStyle.Body1"><strong>@selectedTicket.Priority</strong></RadzenText>
									</RadzenStack>
								</RadzenColumn>
								<RadzenColumn Size="6">
									<RadzenStack Gap="0.25rem">
										<RadzenText TextStyle="TextStyle.Overline">Customers</RadzenText>
										<RadzenText TextStyle="TextStyle.Body1"><strong>@selectedTicket.CustomerImpact</strong></RadzenText>
									</RadzenStack>
								</RadzenColumn>
								<RadzenColumn Size="6">
									<RadzenStack Gap="0.25rem">
										<RadzenText TextStyle="TextStyle.Overline">Assigned Crew</RadzenText>
										<RadzenText TextStyle="TextStyle.Body1"><strong>@(string.IsNullOrWhiteSpace(selectedTicket.AssignedCrewName) ? "Unassigned" : selectedTicket.AssignedCrewName)</strong></RadzenText>
									</RadzenStack>
								</RadzenColumn>
								<RadzenColumn Size="6">
									<RadzenStack Gap="0.25rem">
										<RadzenText TextStyle="TextStyle.Overline">Updated</RadzenText>
										<RadzenText TextStyle="TextStyle.Body1"><strong>@selectedTicket.UpdatedAt.ToLocalTime().ToString("g")</strong></RadzenText>
									</RadzenStack>
								</RadzenColumn>
							</RadzenRow>

							<!-- Assets -->
							@if (selectedTicket.AffectedAssets.Count > 0)
							{
								<RadzenStack Gap="0.5rem">
									<RadzenText TextStyle="TextStyle.Overline">Assets</RadzenText>
									<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
										@foreach (var asset in selectedTicket.AffectedAssets)
										{
											<RadzenBadge Text="@asset" BadgeStyle="BadgeStyle.Light" />
										}
									</RadzenStack>
								</RadzenStack>
							}

							<!-- Actions -->
							<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="tickets-actions">
								<RadzenButton Icon="bolt" data-testid="tickets-promote-action"
											  Disabled="@(!CanPromoteSelectedTicket || isUpdatingStatus)"
											  Click="PromoteTicketAsync">
									@(isUpdatingStatus ? "Updating..." : GetPromoteLabel())
								</RadzenButton>
								<RadzenButton ButtonStyle="ButtonStyle.Light" Icon="undo" Disabled="@isUpdatingStatus" Click="ResetSelection" data-testid="tickets-reset-selection">Reset selection</RadzenButton>
							</RadzenStack>
						</RadzenStack>
					</RadzenCard>

					<!-- Timeline Card -->
					<RadzenCard>
						<TicketTimeline Events="selectedTicket.Events" />
					</RadzenCard>
				</RadzenStack>
			}
		</RadzenSplitterPane>
	</RadzenSplitter>
</RadzenStack>

@code
{
	private readonly IReadOnlyList<DropdownOption<TicketStatus>> statusOptions = Enum.GetValues<TicketStatus>()
		.Select(value => new DropdownOption<TicketStatus>(value.ToString(), value))
		.ToArray();

	private readonly IReadOnlyList<DropdownOption<TicketPriority>> priorityOptions = Enum.GetValues<TicketPriority>()
		.Select(value => new DropdownOption<TicketPriority>(value.ToString(), value))
		.ToArray();

	private IEnumerable<TicketStatus> StatusFilter { get; set; } = new List<TicketStatus> { TicketStatus.Open, TicketStatus.InProgress };
	private TicketPriority? minPriority;
	private bool includeTimeline = true;
	private bool includeRecommendations;
	private IReadOnlyList<TicketDto> tickets = Array.Empty<TicketDto>();
	private TicketDto? selectedTicket;
	private bool isLoading = true;
	private bool isUpdatingStatus;
	private bool isCreatePanelOpen;
	private bool isSavingTicket;
	private string? errorMessage;
	private TicketCreateFormModel createModel = TicketCreateFormModel.CreateDefault();
	private CancellationTokenSource? loadCts;

	protected override async Task OnInitializedAsync()
	{
		await LoadTicketsAsync();
	}

	public void Dispose()
	{
		loadCts?.Cancel();
		loadCts?.Dispose();
	}

	private async Task LoadTicketsAsync(Guid? preferredSelectionId = null)
	{
		loadCts?.Cancel();
		loadCts?.Dispose();
		loadCts = new CancellationTokenSource();

		isLoading = true;
		errorMessage = null;

		var filter = new TicketFilter
		{
			Statuses = StatusFilter.Any() ? StatusFilter.ToArray() : null,
			MinPriority = minPriority,
			IncludeRecommendations = includeRecommendations,
			IncludeTimeline = includeTimeline
		};

		try
		{
			Logger.LogInformation("Loading tickets with filter {@Filter} (preferredSelectionId={PreferredSelectionId})", filter, preferredSelectionId);
			var result = await ApiClient.GetTicketsAsync(filter, loadCts.Token);
			tickets = result.Items
				.OrderByDescending(ticket => ticket.UpdatedAt)
				.ToArray();

			var desiredId = preferredSelectionId ?? selectedTicket?.Id;
			selectedTicket = desiredId is null
				? tickets.FirstOrDefault()
				: tickets.FirstOrDefault(ticket => ticket.Id == desiredId) ?? tickets.FirstOrDefault();
		}
		catch (OperationCanceledException)
		{
			Logger.LogDebug("Ticket load canceled due to filter change or disposal");
		}
		catch (Exception ex)
		{
			errorMessage = $"Unable to load tickets: {ex.Message}";
			Logger.LogError(ex, "Failed to load tickets");
		}
		finally
		{
			isLoading = false;
			Logger.LogInformation("Ticket load complete (count={TicketCount}, selected={SelectedId})", tickets.Count, selectedTicket?.Id);
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task ApplyFiltersAsync()
	{
		Logger.LogInformation("Applying ticket filters: statuses={Statuses}, minPriority={MinPriority}, includeTimeline={IncludeTimeline}, includeRecommendations={IncludeRecommendations}",
			StatusFilter?.ToArray(), minPriority, includeTimeline, includeRecommendations);
		await LoadTicketsAsync();
	}

	private void OnTicketSelected(TicketDto ticket)
	{
		selectedTicket = ticket;
		Logger.LogInformation("Ticket selected {TicketId}", ticket.Id);
	}

	private void ToggleCreatePanel()
	{
		Logger.LogInformation("Toggling create ticket panel (open={State})", !isCreatePanelOpen);
		isCreatePanelOpen = !isCreatePanelOpen;
		if (isCreatePanelOpen)
		{
			createModel = TicketCreateFormModel.CreateDefault();
		}
	}

	private void CancelCreatePanel()
	{
		Logger.LogInformation("Create ticket panel canceled");
		isCreatePanelOpen = false;
		createModel = TicketCreateFormModel.CreateDefault();
	}

	private async Task CreateTicketAsync()
	{
		if (isSavingTicket)
		{
			Logger.LogWarning("Create ticket requested while previous submission still in-flight");
			return;
		}

		isSavingTicket = true;

		try
		{
			var request = new TicketCreateRequest
			{
				Title = createModel.Title,
				OutageReferenceId = createModel.OutageReferenceId,
				Description = createModel.Description,
				Priority = createModel.Priority,
				CustomerImpact = createModel.CustomerImpact,
				AffectedAssets = ParseAssets(createModel.AssetsInput)
			};

			Logger.LogInformation("Submitting ticket create request for outage {OutageReference} with priority {Priority}", request.OutageReferenceId, request.Priority);
			var created = await ApiClient.CreateTicketAsync(request);
			await LoadTicketsAsync(created.Id);
			Logger.LogInformation("Ticket created {TicketId}", created.Id);
			NotificationService.Notify(Radzen.NotificationSeverity.Success, "Ticket created", $"{created.Title} is now in {created.Status} state.");
			isCreatePanelOpen = false;
			createModel = TicketCreateFormModel.CreateDefault();
		}
		catch (Exception ex)
		{
			NotificationService.Notify(Radzen.NotificationSeverity.Error, "Failed to create ticket", ex.Message);
			Logger.LogError(ex, "Ticket creation failed");
		}
		finally
		{
			isSavingTicket = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task PromoteTicketAsync()
	{
		if (selectedTicket is null)
		{
			return;
		}

		var nextStatus = GetNextStatus(selectedTicket.Status);
		if (nextStatus is null)
		{
			Logger.LogWarning("Promote requested but no next status for ticket {TicketId} in status {Status}", selectedTicket.Id, selectedTicket.Status);
			return;
		}

		isUpdatingStatus = true;
		Logger.LogInformation("Promoting ticket {TicketId} from {CurrentStatus} to {NextStatus}", selectedTicket.Id, selectedTicket.Status, nextStatus);

		try
		{
			var request = new TicketStatusUpdateRequest
			{
				Status = nextStatus.Value
			};

			var updated = await ApiClient.UpdateTicketStatusAsync(selectedTicket.Id, request);
			UpsertTicket(updated);
			selectedTicket = updated;
			NotificationService.Notify(Radzen.NotificationSeverity.Success, "Ticket updated", $"Status moved to {updated.Status}.");
			Logger.LogInformation("Ticket {TicketId} promoted to {Status}", updated.Id, updated.Status);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(Radzen.NotificationSeverity.Error, "Unable to update ticket", ex.Message);
			Logger.LogError(ex, "Ticket promotion failed for {TicketId}", selectedTicket.Id);
		}
		finally
		{
			isUpdatingStatus = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private void UpsertTicket(TicketDto updated)
	{
		var mutable = tickets.ToList();
		var index = mutable.FindIndex(ticket => ticket.Id == updated.Id);
		if (index >= 0)
		{
			mutable[index] = updated;
		}
		else
		{
			mutable.Insert(0, updated);
		}

		tickets = mutable;
	}

	private static List<string> ParseAssets(string? value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return new List<string>();
		}

		return value
			.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.Take(20)
			.ToList();
	}

	private void ResetSelection()
	{
		selectedTicket = tickets.FirstOrDefault();
		Logger.LogInformation("Ticket selection reset to first ticket {TicketId}", selectedTicket?.Id);
	}

	private bool ShowDuplicateWarning(TicketDto ticket) => ticket.Events.Any(evt => evt.EventType == AssignmentEventType.TicketDuplicateFlag);

	private bool CanPromoteSelectedTicket => selectedTicket is not null && GetNextStatus(selectedTicket.Status) is not null;

	private static TicketStatus? GetNextStatus(TicketStatus status) => status switch
	{
		TicketStatus.Open => TicketStatus.InProgress,
		TicketStatus.InProgress => TicketStatus.Resolved,
		TicketStatus.Resolved => TicketStatus.Closed,
		_ => null
	};

	private string GetPromoteLabel()
	{
		if (selectedTicket is null)
		{
			return "Promote";
		}

		var next = GetNextStatus(selectedTicket.Status);
		return next is null ? "No further action" : $"Move to {next}";
	}

	private static string GetStatusVariant(TicketStatus status) => status switch
	{
		TicketStatus.Open => "info",
		TicketStatus.InProgress => "warning",
		TicketStatus.Resolved => "success",
		TicketStatus.Closed => "success",
		TicketStatus.Cancelled => "danger",
		_ => "default"
	};

	private sealed record DropdownOption<TValue>(string Label, TValue Value);

	private sealed class TicketCreateFormModel
	{
		[Required]
		[StringLength(140, ErrorMessage = "Title must be 140 characters or fewer.")]
		public string Title { get; set; } = string.Empty;

		[Required]
		public string OutageReferenceId { get; set; } = string.Empty;

		public string? Description { get; set; }
		public TicketPriority Priority { get; set; } = TicketPriority.Medium;

		[Range(0, 100000, ErrorMessage = "Customer impact must be non-negative.")]
		public int CustomerImpact { get; set; }

		public string AssetsInput { get; set; } = string.Empty;

		public static TicketCreateFormModel CreateDefault() => new();
	}
}