@page "/dispatch"
@rendermode InteractiveServer
@using System.Linq
@using GridPulse.Application.Models
@using GridPulse.Domain.Enums
@using GridPulse.Web.Services
@using GridPulse.Web.Components.Organisms
@using Microsoft.Extensions.Logging
@using Radzen
@using Radzen.Blazor
@inject GridPulseApiClient ApiClient
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject ILogger<DispatchBoard> Logger
@implements IDisposable

<RadzenStack class="dispatch-page" Gap="1.5rem">
    <!-- Hero Header -->
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.75rem">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" data-testid="dispatch-heading" Style="margin: 0;">Dispatch Board</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="dispatch-subtitle">Review tickets awaiting crew assignments, evaluate telemetry, and publish decisions</RadzenText>
        </RadzenStack>

        <RadzenButton Icon="refresh" 
                      Variant="Variant.Outlined"
                      Disabled="@isLoadingTickets" 
                      Click="async () => await LoadTicketsAsync()" 
                      data-testid="dispatch-refresh">
            Refresh
        </RadzenButton>
    </RadzenStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" 
                     Variant="Variant.Flat"
                     Shade="Shade.Lighter"
                     Closeable="true" 
                     Text="@errorMessage" />
    }

    @if (!string.IsNullOrEmpty(lastReceiptMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" 
                     Variant="Variant.Flat"
                     Shade="Shade.Lighter"
                     Closeable="true"
                     Close="@DismissToast"
                     Style="margin-bottom: 1rem;"
                     data-testid="assignment-receipt-toast">
            @lastReceiptMessage
        </RadzenAlert>
    }

    <RadzenSplitter Orientation="Orientation.Horizontal" Style="height: calc(100vh - 200px);">
        <RadzenSplitterPane Size="30%" Min="20%" Max="40%">
            <RadzenCard class="dispatch-ticket-card" Style="height: 100%; display: flex; flex-direction: column;">
                <RadzenStack Gap="1rem" Style="flex: 1; min-height: 0;">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H3">Tickets awaiting dispatch</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Class="dispatch-subtitle">Open and in-progress work</RadzenText>
                    </RadzenStack>

                    <RadzenStack Gap="0.5rem" Style="flex: 1; overflow-y: auto;" data-testid="dispatch-ticket-list">
                        @if (isLoadingTickets)
                        {
                            <RadzenSkeleton Lines="6" />
                        }
                        else if (dispatchableTickets.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">No tickets require dispatcher attention right now.</RadzenText>
                        }
                        else
                        {
                            @foreach (var ticket in dispatchableTickets)
                            {
                                var isActive = ticket.Id == selectedTicketId;
                                <RadzenCard Style="@GetTicketCardStyle(isActive)"
                                            @onclick="() => OnTicketSelectedAsync(ticket.Id)">
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start">
                                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: 500;">@ticket.Title</RadzenText>
                                            @if (isActive)
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-primary);" />
                                            }
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                            <StatusChip Label="@ticket.Status.ToString()" Variant="@GetStatusVariant(ticket.Status)" />
                                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"P{ticket.Priority}")" />
                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{ticket.CustomerImpact} customers")" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenCard>
                            }
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenSplitterPane>

        <RadzenSplitterPane>
            <RadzenStack Gap="1rem" Style="height: 100%; padding: 0.5rem; overflow-y: auto;">
                <RadzenCard class="dispatch-recommendations-card">
                    <RadzenStack Gap="12px">
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H3">Crew recommendations</RadzenText>
                            @if (selectedTicket is not null)
                            {
                                <RadzenText TextStyle="TextStyle.Body2" Class="dispatch-subtitle">@selectedTicket.Title</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                    AI-recommended crews based on proximity, skills, workload, and availability. <RadzenIcon Icon="star" Style="font-size: 14px; vertical-align: middle;" /> = Best match
                                </RadzenText>
                            }
                        </RadzenStack>

                    @if (selectedRecommendation is not null && !selectedRecommendation.IsAutoSelected)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                                <RadzenIcon Icon="info" Style="margin-top: 2px;" />
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle2">Override required</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        You've selected <strong>@selectedRecommendation.Crew.DisplayName</strong> instead of the AI-recommended crew. Click the button below to provide a justification.
                                    </RadzenText>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenAlert>
                    }

                    @if (isLoadingRecommendations)
                    {
                        <RadzenSkeleton Lines="6" />
                    }
                    else if (recommendations.Count == 0)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Text="No recommendations available for the selected ticket." />
                    }
                    else
                    {
                        var staleCount = recommendations.Count(rec => rec.Crew.IsTelemetryStale);
                        if (staleCount > 0)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Text="@BuildTelemetryWarning(staleCount)" />
                        }

                        <RadzenDataGrid TItem="DispatchRecommendationDto" 
                                       Data="@recommendations" 
                                       @bind-Value="@selectedRecommendations"
                                       SelectionMode="DataGridSelectionMode.Single"
                                       AllowRowSelectOnRowClick="true"
                                       RowSelect="@(args => OnRecommendationSelected(args))"
                                       data-testid="crew-recommendations-grid"
                                       AllowSorting="true"
                                       Style="margin: 1rem 0;">
                            <Columns>
                                <RadzenDataGridColumn TItem="DispatchRecommendationDto" Title="Crew" Width="200px">
                                    <Template Context="recommendation">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Subtitle1">@recommendation.Crew.DisplayName</RadzenText>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                                <RadzenText TextStyle="TextStyle.Caption">@recommendation.Crew.Status</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Caption">@string.Join(", ", recommendation.Crew.Skills)</RadzenText>
                                            </RadzenStack>
                                            @if (recommendation.Crew.IsTelemetryStale)
                                            {
                                                <RadzenBadge Text="Telemetry stale" BadgeStyle="BadgeStyle.Warning" data-testid="telemetry-stale-badge" />
                                            }
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="DispatchRecommendationDto" Title="Score" Width="120px">
                                    <Template Context="recommendation">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenBadge Text="@recommendation.CompositeScore.ToString("P0")" BadgeStyle="BadgeStyle.Success" data-testid="score-chip" />
                                            <RadzenText TextStyle="TextStyle.Caption">ETA @recommendation.EtaMinutes mins</RadzenText>
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="DispatchRecommendationDto" Title="Workload" Width="150px">
                                    <Template Context="recommendation">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Body2">@recommendation.Crew.CurrentTicketCount active</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption">@(recommendation.ScoreComponents.TryGetValue("workload", out var workloadScore) ? $"Workload {workloadScore:P0}" : string.Empty)</RadzenText>
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="DispatchRecommendationDto" Title="Status" Width="100px" Sortable="false">
                                    <Template Context="recommendation">
                                        @if (recommendation.IsAutoSelected)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
                                                <RadzenIcon Icon="star" Style="color: var(--rz-info);" />
                                                <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-info);">Recommended</RadzenText>
                                            </RadzenStack>
                                        }
                                        else if (recommendation.IsOverride && !string.IsNullOrWhiteSpace(recommendation.OverrideReason))
                                        {
                                            <RadzenBadge Text="@($"Override: {recommendation.OverrideReason}")" BadgeStyle="BadgeStyle.Warning" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }

                    @if (selectedRecommendation is not null)
                    {
                        var isOverrideSelection = !selectedRecommendation.IsAutoSelected;
                        var buttonIcon = isOverrideSelection ? "edit_note" : "check_circle";
                        var buttonStyle = isOverrideSelection ? ButtonStyle.Warning : ButtonStyle.Success;
                        var buttonText = isPublishingAssignment ? "Publishing..." : 
                                        isOverrideSelection ? $"Provide reason to assign {selectedRecommendation.Crew.DisplayName}" : 
                                        $"Assign {selectedRecommendation.Crew.DisplayName}";

                        <RadzenStack Gap="0.5rem">
                            <RadzenButton Icon="@buttonIcon" 
                                         ButtonStyle="@buttonStyle"
                                         Disabled="@(!CanPublishAssignment)" 
                                         Click="HandlePublishClickAsync" 
                                         data-testid="dispatch-publish"
                                         Style="width: 100%;">
                                @buttonText
                            </RadzenButton>
                            @if (isOverrideSelection)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); text-align: center;">
                                    <RadzenIcon Icon="warning" Style="font-size: 12px; vertical-align: middle;" /> Selecting a different crew than recommended requires justification
                                </RadzenText>
                            }
                            else
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success); text-align: center;">
                                    <RadzenIcon Icon="check_circle" Style="font-size: 12px; vertical-align: middle;" /> Using AI-recommended crew
                                </RadzenText>
                            }
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenButton Icon="check_circle" Disabled="true" data-testid="dispatch-publish" Style="width: 100%;">
                            Select a crew from the list above
                        </RadzenButton>
                    }
                </RadzenStack>
                </RadzenCard>

                <RadzenStack Gap="1rem">
                    <RadzenStack data-testid="dispatch-timeline">
                        <TicketTimeline Events="@(selectedTicket?.Events ?? Array.Empty<AssignmentEventDto>())" />
                    </RadzenStack>
                    <RadzenStack>
                        @{
                            var activeCrew = ActiveCrew;
                        }
                        @if (activeCrew is not null && selectedTicket is not null)
                        {
                            <CrewStatusPanel Crew="activeCrew"
                                             Timeline="@(selectedTicket?.Events ?? Array.Empty<AssignmentEventDto>())"
                                             IsSubmitting="isSubmittingCrewStatus"
                                             StatusSubmitted="OnCrewStatusSubmittedAsync" />
                        }
                        else
                        {
                            <RadzenCard Style="padding: 2rem; text-align: center;">
                                <RadzenText TextStyle="TextStyle.Body2">Select a dispatched ticket to manage crew acknowledgements.</RadzenText>
                            </RadzenCard>
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenStack>
        </RadzenSplitterPane>
    </RadzenSplitter>
</RadzenStack>

@code {
    private static readonly TimeSpan RecommendationRefreshInterval = TimeSpan.FromSeconds(45);
    private IReadOnlyList<TicketDto> dispatchableTickets = Array.Empty<TicketDto>();
    private TicketDto? selectedTicket;
    private Guid? selectedTicketId;
    private IReadOnlyList<DispatchRecommendationDto> recommendations = Array.Empty<DispatchRecommendationDto>();
    private DispatchRecommendationDto? selectedRecommendation;
    private IList<DispatchRecommendationDto> selectedRecommendations = new List<DispatchRecommendationDto>();
    private bool isLoadingTickets = true;
    private bool isLoadingRecommendations;
    private bool isSubmittingCrewStatus;
    private bool isPublishingAssignment;
    private string? overrideReason;
    private string? overrideErrorMessage;
    private string? errorMessage;
    private string? lastReceiptMessage;
    private CancellationTokenSource? recommendationsCts;
    private CancellationTokenSource? refreshLoopCts;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Dispatch board initializing");
        await LoadTicketsAsync();
        refreshLoopCts = new CancellationTokenSource();
        _ = RefreshRecommendationsLoopAsync(refreshLoopCts.Token);
    }

    public void Dispose()
    {
        Logger.LogInformation("Disposing dispatch board");
        recommendationsCts?.Cancel();
        recommendationsCts?.Dispose();

        refreshLoopCts?.Cancel();
        refreshLoopCts?.Dispose();
    }

    private async Task LoadTicketsAsync(Guid? preferredSelection = null)
    {
        isLoadingTickets = true;
        errorMessage = null;

        var filter = new TicketFilter
        {
            Statuses = new[] { TicketStatus.Open, TicketStatus.InProgress },
            IncludeTimeline = true,
            IncludeRecommendations = true
        };

        try
        {
            Logger.LogInformation("Loading dispatch tickets with filter {@Filter}", filter);
            var result = await ApiClient.GetTicketsAsync(filter);
            dispatchableTickets = result.Items
                .Where(ticket => ticket.Status is TicketStatus.Open or TicketStatus.InProgress)
                .OrderBy(ticket => ticket.Status == TicketStatus.InProgress ? 0 : 1)
                .ThenBy(ticket => HasAssignmentPublishedEvent(ticket) ? 0 : 1)
                .ThenBy(ticket => ticket.AssignedCrewId is not null ? 0 : 1)
                .ThenBy(ticket => HasRecommendations(ticket) ? 0 : 1)
                .ThenBy(ticket => ticket.Priority)
                .ThenByDescending(ticket => ticket.UpdatedAt)
                .ToArray();

            var desiredId = preferredSelection
                ?? selectedTicketId
                ?? dispatchableTickets.FirstOrDefault(IsDispatchReadyTicket)?.Id
                ?? dispatchableTickets.FirstOrDefault(ticket => ticket.Status == TicketStatus.InProgress)?.Id
                ?? dispatchableTickets.FirstOrDefault()?.Id;
            selectedTicket = desiredId is null
                ? dispatchableTickets.FirstOrDefault()
                : dispatchableTickets.FirstOrDefault(ticket => ticket.Id == desiredId) ?? dispatchableTickets.FirstOrDefault();

            selectedTicketId = selectedTicket?.Id;

            if (selectedTicket is not null)
            {
                Logger.LogInformation("Selected dispatch ticket {TicketId}", selectedTicket.Id);
                await LoadRecommendationsAsync(selectedTicket.Id);
            }
            else
            {
                recommendations = Array.Empty<DispatchRecommendationDto>();
                selectedRecommendation = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load dispatch tickets: {ex.Message}";
            Logger.LogError(ex, "Failed to load dispatch tickets");
        }
        finally
        {
            isLoadingTickets = false;
            Logger.LogInformation("Dispatch tickets loaded (count={TicketCount})", dispatchableTickets.Count);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnRecommendationSelected(DispatchRecommendationDto recommendation)
    {
        selectedRecommendation = recommendation;
        Logger.LogInformation("Recommendation selected for ticket {TicketId}: crew {CrewId} (override={IsOverride}, auto={IsAuto})",
            selectedTicket?.Id, recommendation.Crew.CrewId, recommendation.IsOverride, recommendation.IsAutoSelected);
    }

    private async Task LoadRecommendationsAsync(Guid ticketId)
    {
        recommendationsCts?.Cancel();
        recommendationsCts?.Dispose();
        recommendationsCts = new CancellationTokenSource();

        isLoadingRecommendations = true;
        errorMessage = null;

        try
        {
            Logger.LogInformation("Loading recommendations for ticket {TicketId}", ticketId);
            var envelope = await ApiClient.GetRecommendationsAsync(ticketId, recommendationsCts.Token);
            recommendations = envelope.Recommendations
                .OrderByDescending(rec => rec.CompositeScore)
                .ToArray();

            selectedRecommendation = recommendations.FirstOrDefault(rec => rec.IsAutoSelected) ?? recommendations.FirstOrDefault();
            var selectedCrewId = selectedRecommendation?.Crew.CrewId;
            Logger.LogInformation("Loaded {RecommendationCount} recommendations (selected crew={CrewId})", recommendations.Count, selectedCrewId);
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Recommendation load canceled for ticket {TicketId}", ticketId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load recommendations: {ex.Message}";
            recommendations = Array.Empty<DispatchRecommendationDto>();
            selectedRecommendation = null;
            Logger.LogError(ex, "Failed to load recommendations for ticket {TicketId}", ticketId);
        }
        finally
        {
            isLoadingRecommendations = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnTicketSelectedAsync(Guid ticketId)
    {
        if (selectedTicketId == ticketId)
        {
            return;
        }

        var ticket = dispatchableTickets.FirstOrDefault(t => t.Id == ticketId);
        if (ticket is null)
        {
            return;
        }

        selectedTicket = ticket;
        selectedTicketId = ticket.Id;
        Logger.LogInformation("Dispatcher selected ticket {TicketId}", ticket.Id);
        await LoadRecommendationsAsync(ticket.Id);
    }

    private async Task HandleOverrideSendAsync(DialogService ds)
    {
        // Refresh recommendations right before sending to ensure they're current
        if (selectedTicket?.Id is Guid ticketId)
        {
            Logger.LogInformation("Refreshing recommendations before override dispatch");
            await LoadRecommendationsAsync(ticketId);
        }
        
        await PublishAssignmentAsync(isOverride: true);
        
        // Only close dialog if there was no error
        if (string.IsNullOrEmpty(overrideErrorMessage))
        {
            ds.Close(true);
        }
    }

    private async Task OpenOverrideDialog()
    {
        if (!CanPublishAssignment)
        {
            return;
        }

        overrideReason = string.Empty;
        overrideErrorMessage = null;
        var ticketId = selectedTicket?.Id;
        Logger.LogInformation("Override dialog opened for ticket {TicketId}", ticketId);

        var result = await DialogService.OpenAsync("Override recommendation", ds =>
            @<RadzenStack Gap="1.5rem">
                <RadzenText TextStyle="TextStyle.Body2">Provide a brief justification before sending the assignment.</RadzenText>
                
                <RadzenStack Gap="0.5rem">
                    <RadzenLabel Text="Override reason" Component="override-reason" />
                    <RadzenTextArea id="override-reason"
                                    @bind-Value="@overrideReason"
                                    Name="OverrideReason"
                                    Rows="3"
                                    Placeholder="Explain why a non-automatic crew was selected"
                                    data-testid="override-reason" />
                </RadzenStack>

                @if (!string.IsNullOrEmpty(overrideErrorMessage))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @overrideErrorMessage
                    </RadzenAlert>
                }

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Icon="send" 
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Disabled="@isPublishingAssignment" 
                                  Click="async () => await HandleOverrideSendAsync(ds)"
                                  data-testid="dispatch-override-send">
                        @(isPublishingAssignment ? "Sending..." : "Send assignment")
                    </RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                  Icon="cancel" 
                                  Click="() => ds.Close(false)"
                                  data-testid="dispatch-override-cancel">
                        Cancel
                    </RadzenButton>
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { 
                Width = "500px",
                Resizable = false,
                Draggable = true
            }
        );

        string dialogResult = result != null ? result.ToString() : "cancelled";
        Logger.LogInformation("Override dialog closed with result: {Result}", dialogResult);
    }

    private async Task HandlePublishClickAsync()
    {
        if (selectedRecommendation is null)
        {
            return;
        }

        // If the selected recommendation is NOT auto-selected, require an override reason
        if (!selectedRecommendation.IsAutoSelected)
        {
            Logger.LogInformation("Selected crew is not auto-selected, opening override dialog");
            await OpenOverrideDialog();
            return;
        }

        // Otherwise, proceed with normal publish
        await PublishAssignmentAsync(isOverride: false);
    }
    
    private static string ExtractFriendlyErrorMessage(string errorMessage)
    {
        // Error format from API: "409 Conflict: Recommendation is stale..."
        if (errorMessage.Contains(':') && errorMessage.Contains("Conflict"))
        {
            var parts = errorMessage.Split(':', 2);
            return parts.Length > 1 ? parts[1].Trim() : errorMessage;
        }
        
        return errorMessage;
    }

    private async Task PublishAssignmentAsync(bool isOverride)
    {
        if (selectedTicket is null || selectedRecommendation is null)
        {
            return;
        }

        if (isOverride && string.IsNullOrWhiteSpace(overrideReason))
        {
            overrideErrorMessage = "Override reason is required.";
            Logger.LogWarning("Override attempted without reason for ticket {TicketId}", selectedTicket?.Id);
            return;
        }

        isPublishingAssignment = true;
        overrideErrorMessage = null;
        errorMessage = null;
        Logger.LogInformation("Publishing assignment for ticket {TicketId} (crew={CrewId}, override={IsOverride})", selectedTicket.Id, selectedRecommendation.Crew.CrewId, isOverride);

        var request = new DispatchAssignmentRequest
        {
            TicketId = selectedTicket.Id,
            CrewId = selectedRecommendation.Crew.CrewId,
            OverrideReason = isOverride ? overrideReason : null,
            NotifyCrewChannels = new[] { "push" }
        };

        try
        {
            var receipt = await ApiClient.PublishAssignmentAsync(request);
            lastReceiptMessage = $"Assignment queued for {selectedRecommendation.Crew.DisplayName} (tracking {receipt.TrackingId}).";
            await LoadTicketsAsync(selectedTicket.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Assignment queued", lastReceiptMessage);
            Logger.LogInformation("Assignment published for ticket {TicketId} with tracking {TrackingId}", selectedTicket.Id, receipt.TrackingId);
        }
        catch (HttpRequestException ex)
        {
            // Extract friendly error message from HTTP exception (includes ProblemDetails)
            var friendlyMessage = ExtractFriendlyErrorMessage(ex.Message);
            
            if (isOverride)
            {
                overrideErrorMessage = friendlyMessage;
            }
            else
            {
                errorMessage = $"Unable to publish assignment: {friendlyMessage}";
                NotificationService.Notify(NotificationSeverity.Error, "Assignment failed", friendlyMessage);
            }
            
            Logger.LogError(ex, "Failed to publish assignment for ticket {TicketId}", selectedTicket.Id);
        }
        catch (Exception ex)
        {
            var message = ex.Message;
            
            if (isOverride)
            {
                overrideErrorMessage = message;
            }
            else
            {
                errorMessage = $"Unable to publish assignment: {message}";
                NotificationService.Notify(NotificationSeverity.Error, "Assignment failed", message);
            }
            
            Logger.LogError(ex, "Failed to publish assignment for ticket {TicketId}", selectedTicket.Id);
        }
        finally
        {
            isPublishingAssignment = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshRecommendationsLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            Logger.LogInformation("Starting recommendation refresh loop");
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(RecommendationRefreshInterval, cancellationToken);

                if (selectedTicketId is Guid ticketId && !isLoadingTickets)
                {
                    await InvokeAsync(() => LoadRecommendationsAsync(ticketId));
                }
            }
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Recommendation refresh loop canceled");
        }
    }

    private async Task OnCrewStatusSubmittedAsync(CrewAssignmentStatus status)
    {
        if (selectedTicket?.AssignedCrewId is not Guid crewId)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Crew unavailable", "Assign a crew before sending status updates.");
            return;
        }

        isSubmittingCrewStatus = true;
        errorMessage = null;

        var request = new CrewStatusUpdateRequest
        {
            Status = status,
            Note = status switch
            {
                CrewAssignmentStatus.Completed => "Dispatcher marked ticket completed",
                CrewAssignmentStatus.Acknowledged => "Crew acknowledgement simulated by dispatcher",
                _ => "Dispatcher updated crew status"
            }
        };

        try
        {
            await ApiClient.PostCrewStatusAsync(crewId, request);
            if (selectedTicket is not null)
            {
                lastReceiptMessage = BuildCrewStatusToast(status, selectedTicket.Title);
            }

            lastReceiptMessage ??= "Crew status sent.";
            NotificationService.Notify(NotificationSeverity.Success, "Crew status sent", lastReceiptMessage);
            await LoadTicketsAsync(selectedTicket?.Id);
            var ticketId = selectedTicket?.Id;
            Logger.LogInformation("Crew status {Status} posted for crew {CrewId} on ticket {TicketId}", status, crewId, ticketId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to send crew status: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Crew status failed", ex.Message);
            Logger.LogError(ex, "Failed to send crew status for crew {CrewId} on ticket {TicketId}", crewId, selectedTicket?.Id);
        }
        finally
        {
            isSubmittingCrewStatus = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DismissToast()
    {
        Logger.LogInformation("Dispatcher dismissed toast message");
        lastReceiptMessage = null;
    }

    private bool CanPublishAssignment => selectedTicket is not null && selectedRecommendation is not null && !isPublishingAssignment;
    private CrewStatusDto? ActiveCrew
    {
        get
        {
            if (selectedTicket?.AssignedCrewId is not Guid crewId)
            {
                return null;
            }

            var ticketRecommendations = selectedTicket.Recommendations ?? Array.Empty<DispatchRecommendationDto>();
            var ticketCrew = ticketRecommendations.FirstOrDefault(rec => rec.Crew.CrewId == crewId)?.Crew;
            if (ticketCrew is not null)
            {
                return ticketCrew;
            }

            var currentRecommendation = recommendations.FirstOrDefault(rec => rec.Crew.CrewId == crewId)?.Crew;
            if (currentRecommendation is not null)
            {
                return currentRecommendation;
            }

            return selectedRecommendation?.Crew.CrewId == crewId ? selectedRecommendation.Crew : null;
        }
    }

    private static string ToAriaBool(bool value) => value ? "true" : "false";

    private static string GetTicketCardStyle(bool isActive) =>
        isActive
            ? "cursor: pointer; transition: all 0.2s ease; border: 2px solid var(--rz-primary); background: var(--rz-primary-lighter);"
            : "cursor: pointer; transition: all 0.2s ease; border: 1px solid var(--rz-base-300); background: var(--rz-base-background-color);";

    private static string BuildTelemetryWarning(int staleCount) =>
        $"Telemetry stale for {staleCount} crew{(staleCount == 1 ? string.Empty : "s")}.";

    private static string GetStatusVariant(TicketStatus status) => status switch
    {
        TicketStatus.Open => "warning",
        TicketStatus.InProgress => "info",
        TicketStatus.Resolved or TicketStatus.Closed => "success",
        TicketStatus.Cancelled => "danger",
        _ => "default"
    };

    private static string BuildCrewStatusToast(CrewAssignmentStatus status, string ticketTitle) => status switch
    {
        CrewAssignmentStatus.Acknowledged => $"Crew acknowledgement sent for {ticketTitle}.",
        _ => $"Crew status '{status}' sent for {ticketTitle}."
    };

    private static bool HasAssignmentPublishedEvent(TicketDto ticket)
    {
        var events = ticket.Events ?? Array.Empty<AssignmentEventDto>();
        return events.Any(evt => evt.EventType == AssignmentEventType.AssignmentPublished);
    }

    private static bool HasRecommendations(TicketDto ticket) => (ticket.Recommendations?.Count ?? 0) > 0;

    private static bool IsDispatchReadyTicket(TicketDto ticket) =>
        ticket.Status == TicketStatus.InProgress
        && ticket.AssignedCrewId is not null
        && HasAssignmentPublishedEvent(ticket);
}
