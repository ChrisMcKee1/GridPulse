@page "/"
@using GridPulse.Web.Services.Models
@using TicketDto = GridPulse.Web.Services.GridPulseApiClient.TicketDto
@using TicketListResponse = GridPulse.Web.Services.GridPulseApiClient.TicketListResponse
@inject GridPulse.Web.Services.GridPulseApiClient ApiClient

<PageTitle>Zava Power · GridPulse</PageTitle>

<RadzenStack Gap="var(--gp-space-2xl)" class="dashboard-template" Style="padding: var(--gp-space-xl);">
	@if (isLoading)
	{
		<RadzenStack Gap="var(--gp-space-xl)">
			<RadzenSkeleton Width="100%" Height="140px" Style="border-radius: var(--gp-radius-lg);" />
			<RadzenRow Gap="var(--gp-space-lg)">
				<RadzenColumn Size="12" SizeMD="4"><RadzenSkeleton Height="160px" Style="border-radius: var(--gp-radius-lg);" /></RadzenColumn>
				<RadzenColumn Size="12" SizeMD="4"><RadzenSkeleton Height="160px" Style="border-radius: var(--gp-radius-lg);" /></RadzenColumn>
				<RadzenColumn Size="12" SizeMD="4"><RadzenSkeleton Height="160px" Style="border-radius: var(--gp-radius-lg);" /></RadzenColumn>
			</RadzenRow>
			<RadzenSkeleton Width="100%" Height="400px" Style="border-radius: var(--gp-radius-lg);" />
		</RadzenStack>
	}
	else if (tickets.Items.Count == 0 && outages.Count == 0)
	{
		<RadzenCard Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border);">
			<RadzenAlert Severity="AlertSeverity.Info" 
						 Variant="Variant.Flat"
						 AlertStyle="AlertStyle.Info"
						 Shade="Shade.Lighter">
				<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="var(--gp-space-lg)">
					<RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--gp-success);" />
					<div>
						<strong style="display: block; margin-bottom: 0.5rem; font-size: 1.125rem;">All Clear</strong>
						<span style="color: var(--gp-text-secondary);">There are no active tickets or outages at the moment. Grid is operating normally.</span>
					</div>
				</RadzenStack>
			</RadzenAlert>
		</RadzenCard>
	}
	else
	{
		<!-- Hero Header Section -->
		<RadzenStack Orientation="Orientation.Horizontal" 
					 JustifyContent="JustifyContent.SpaceBetween" 
					 AlignItems="AlignItems.Center" 
					 Wrap="FlexWrap.Wrap"
					 Gap="var(--gp-space-lg)"
					 Style="padding: var(--gp-space-lg); background: var(--gp-surface); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm);">
			<div>
				<h1 style="margin: 0; font-size: 2rem; font-weight: 600; color: var(--gp-text-primary); background: none; -webkit-text-fill-color: inherit;">Grid Operations Dashboard</h1>
				<p style="color: var(--gp-text-secondary); margin: var(--gp-space-sm) 0 0; font-size: 0.875rem;">Real-time monitoring and ticket management</p>
			</div>
			<RadzenStack Orientation="Orientation.Horizontal" Gap="var(--gp-space-sm)" AlignItems="AlignItems.Center">
				<RadzenBadge BadgeStyle="BadgeStyle.Danger" Variant="Variant.Flat" Text="@ActiveTickets" Style="font-size: 1.25rem; padding: 0.5rem 1rem;" />
				<span style="color: var(--gp-text-secondary); font-weight: 500;">Active Tickets</span>
			</RadzenStack>
		</RadzenStack>

		<!-- KPI Cards Grid -->
		<RadzenRow Gap="var(--gp-space-lg)">
			<RadzenColumn Size="12" SizeMD="3">
				<RadzenCard class="kpi-card" Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm); transition: all var(--gp-transition-base);">
					<RadzenStack Gap="var(--gp-space-sm)">
						<span class="kpi-card__title" style="color: var(--gp-text-secondary); font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">Open Tickets</span>
						<div class="kpi-card__value-group">
							<span class="kpi-card__value" style="font-size: 2.5rem; font-weight: 700; color: var(--gp-text-primary); line-height: 1;">@OpenTicketsCount</span>
						</div>
						<span class="kpi-card__trend" style="color: var(--gp-text-tertiary); font-size: 0.875rem; margin-top: var(--gp-space-xs);">@HighPriorityCount high priority</span>
					</RadzenStack>
				</RadzenCard>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="3">
				<RadzenCard class="kpi-card" Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm); transition: all var(--gp-transition-base);">
					<RadzenStack Gap="var(--gp-space-sm)">
						<span class="kpi-card__title" style="color: var(--gp-text-secondary); font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">In Progress</span>
						<div class="kpi-card__value-group">
							<span class="kpi-card__value" style="font-size: 2.5rem; font-weight: 700; color: var(--gp-text-primary); line-height: 1;">@InProgressCount</span>
						</div>
						<span class="kpi-card__trend" style="color: var(--gp-text-tertiary); font-size: 0.875rem; margin-top: var(--gp-space-xs);">@CrewsAssignedCount crews assigned</span>
					</RadzenStack>
				</RadzenCard>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="3">
				<RadzenCard class="kpi-card" Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm); transition: all var(--gp-transition-base);">
					<RadzenStack Gap="var(--gp-space-sm)">
						<span class="kpi-card__title" style="color: var(--gp-text-secondary); font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">Customers Impacted</span>
						<div class="kpi-card__value-group">
							<span class="kpi-card__value" style="font-size: 2.5rem; font-weight: 700; color: var(--gp-text-primary); line-height: 1;">@TotalCustomerImpact</span>
						</div>
						<span class="kpi-card__trend" style="color: var(--gp-text-tertiary); font-size: 0.875rem; margin-top: var(--gp-space-xs);">across all tickets</span>
					</RadzenStack>
				</RadzenCard>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="3">
				<RadzenCard class="kpi-card" Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm); transition: all var(--gp-transition-base);">
					<RadzenStack Gap="var(--gp-space-sm)">
						<span class="kpi-card__title" style="color: var(--gp-text-secondary); font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">Resolved Today</span>
						<div class="kpi-card__value-group">
							<span class="kpi-card__value" style="font-size: 2.5rem; font-weight: 700; color: var(--gp-success); line-height: 1;">@ResolvedTodayCount</span>
						</div>
						<span class="kpi-card__trend" style="color: var(--gp-text-tertiary); font-size: 0.875rem; margin-top: var(--gp-space-xs);">@AvgResolutionTime avg time</span>
					</RadzenStack>
				</RadzenCard>
			</RadzenColumn>
		</RadzenRow>

		<!-- Main Content Grid -->
		<RadzenRow Gap="var(--gp-space-lg)">
			<!-- Left Column: Charts -->
			<RadzenColumn Size="12" SizeLG="8">
				<RadzenStack Gap="var(--gp-space-lg)">
					<!-- Ticket Timeline Chart -->
					<RadzenCard Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm);">
						<RadzenStack Gap="var(--gp-space-md)">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: var(--gp-text-primary);">Ticket Activity (Last 7 Days)</h3>
							</div>
							<div style="height: 300px; display: flex; align-items: flex-end; justify-content: space-around; gap: var(--gp-space-sm); padding: var(--gp-space-lg) 0;">
								@foreach (var day in ticketTimeline)
								{
									var barHeight = day.Count == 0 ? 0 : Math.Max((day.Count * 100.0 / (ticketTimeline.Max(t => t.Count) + 1)), 10);
									<div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: var(--gp-space-xs);">
										<div style="width: 100%; background: var(--gp-primary); border-radius: var(--gp-radius-sm); height: @(barHeight)%; min-height: 4px; display: flex; align-items: center; justify-content: center;">
											@if (day.Count > 0)
											{
												<span style="color: white; font-size: 0.75rem; font-weight: 600;">@day.Count</span>
											}
										</div>
										<span style="color: var(--gp-text-tertiary); font-size: 0.75rem;">@day.Date</span>
									</div>
								}
							</div>
						</RadzenStack>
					</RadzenCard>

					<!-- Priority Distribution -->
					<RadzenCard Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm);">
						<RadzenStack Gap="var(--gp-space-md)">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: var(--gp-text-primary);">Priority Distribution</h3>
							</div>
							<RadzenStack Gap="var(--gp-space-md)">
								@foreach (var priority in priorityDistribution)
								{
									var percentage = tickets.Items.Count == 0 ? 0 : (priority.Count * 100.0 / tickets.Items.Count);
									var barColor = priority.Priority switch {
										"High" => "#EF4444",
										"Medium" => "#F59E0B",
										"Low" => "#10B981",
										_ => "#6B7280"
									};
									<div>
										<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--gp-space-xs);">
											<RadzenStack Orientation="Orientation.Horizontal" Gap="var(--gp-space-sm)" AlignItems="AlignItems.Center">
												<div style="width: 12px; height: 12px; border-radius: 50%; background: @barColor;"></div>
												<span style="font-weight: 500; color: var(--gp-text-primary);">@priority.Priority</span>
											</RadzenStack>
											<span style="font-weight: 600; color: var(--gp-text-primary);">@priority.Count (@percentage.ToString("F0")%)</span>
										</div>
										<div style="width: 100%; height: 24px; background: var(--gp-bg-tertiary); border-radius: var(--gp-radius-sm); overflow: hidden;">
											<div style="height: 100%; background: @barColor; width: @(percentage)%; transition: width 0.3s ease;"></div>
										</div>
									</div>
								}
							</RadzenStack>
						</RadzenStack>
					</RadzenCard>
				</RadzenStack>
			</RadzenColumn>

			<!-- Right Column: Status Summary & Recent Tickets -->
			<RadzenColumn Size="12" SizeLG="4">
				<RadzenStack Gap="var(--gp-space-lg)">
					<!-- Status Summary -->
					<RadzenCard Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm);">
						<RadzenStack Gap="var(--gp-space-lg)">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: var(--gp-text-primary);">Status Overview</h3>
							</div>
							<RadzenStack Gap="var(--gp-space-md)">
								@foreach (var status in statusBreakdown)
								{
									<div style="display: flex; justify-content: space-between; align-items: center; padding: var(--gp-space-md); border-radius: var(--gp-radius-md); background: var(--gp-bg-tertiary);">
										<RadzenStack Orientation="Orientation.Horizontal" Gap="var(--gp-space-sm)" AlignItems="AlignItems.Center">
											<RadzenBadge BadgeStyle="@GetStatusBadgeStyle(status.Status)" Variant="Variant.Flat" Style="width: 8px; height: 8px; padding: 0;" />
											<span style="font-weight: 500; color: var(--gp-text-primary);">@status.Status</span>
										</RadzenStack>
										<span style="font-size: 1.5rem; font-weight: 700; color: var(--gp-text-primary);">@status.Count</span>
									</div>
								}
							</RadzenStack>
						</RadzenStack>
					</RadzenCard>

					<!-- Recent High Priority Tickets -->
					<RadzenCard Style="padding: var(--gp-space-xl); border-radius: var(--gp-radius-lg); border: 1px solid var(--gp-border); box-shadow: var(--gp-shadow-sm);">
						<RadzenStack Gap="var(--gp-space-lg)">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: var(--gp-text-primary);">High Priority</h3>
								<RadzenBadge BadgeStyle="BadgeStyle.Danger" Variant="Variant.Flat" Text="@highPriorityTickets.Count.ToString()" />
							</div>
							<RadzenStack Gap="var(--gp-space-sm)">
								@foreach (var ticket in highPriorityTickets.Take(5))
								{
									<div style="padding: var(--gp-space-md); border-radius: var(--gp-radius-md); border: 1px solid var(--gp-border); background: var(--gp-bg-secondary);">
										<RadzenStack Gap="var(--gp-space-xs)">
											<div style="display: flex; justify-content: space-between; align-items: start;">
												<span style="font-weight: 600; color: var(--gp-text-primary); font-size: 0.875rem;">@ticket.Title</span>
												<RadzenBadge BadgeStyle="@GetPriorityBadgeStyle(ticket.Priority)" Text="@ticket.Priority" Variant="Variant.Flat" Style="font-size: 0.75rem;" />
											</div>
											<div style="display: flex; justify-content: space-between; align-items: center;">
												<span style="color: var(--gp-text-tertiary); font-size: 0.75rem;">@ticket.OpenedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
												@if (ticket.CustomerImpact > 0)
												{
													<span style="color: var(--gp-text-secondary); font-size: 0.75rem;">@ticket.CustomerImpact customers</span>
												}
											</div>
										</RadzenStack>
									</div>
								}
							</RadzenStack>
						</RadzenStack>
					</RadzenCard>
				</RadzenStack>
			</RadzenColumn>
		</RadzenRow>
	}
</RadzenStack>

@code {
	private IReadOnlyList<OutageSummaryResponse> outages = Array.Empty<OutageSummaryResponse>();
	private TicketListResponse tickets = new(Array.Empty<TicketDto>(), 0);
	private List<TicketDto> highPriorityTickets = new();
	private List<TimelinePoint> ticketTimeline = new();
	private List<PriorityPoint> priorityDistribution = new();
	private List<StatusPoint> statusBreakdown = new();
	private bool isLoading = true;

	// KPI Computed Properties
	private string ActiveTickets => tickets.Items.Count(t => t.Status != "Resolved" && t.Status != "Closed").ToString("N0");
	private string OpenTicketsCount => tickets.Items.Count(t => t.Status == "Open").ToString("N0");
	private string InProgressCount => tickets.Items.Count(t => t.Status == "InProgress").ToString("N0");
	private string TotalCustomerImpact => tickets.Items.Sum(t => t.CustomerImpact).ToString("N0");
	private string ResolvedTodayCount => tickets.Items.Count(t => t.ClosedAt.HasValue && t.ClosedAt.Value.Date == DateTime.Today).ToString("N0");
	private string HighPriorityCount => tickets.Items.Count(t => t.Priority == "High").ToString("N0");
	private string CrewsAssignedCount => tickets.Items.Count(t => t.AssignedCrewId.HasValue).ToString("N0");
	
	private string AvgResolutionTime
	{
		get
		{
			var resolvedToday = tickets.Items.Where(t => t.ClosedAt.HasValue && t.ClosedAt.Value.Date == DateTime.Today).ToList();
			if (resolvedToday.Count == 0) return "N/A";
			var avgMinutes = resolvedToday.Average(t => (t.ClosedAt!.Value - t.OpenedAt).TotalMinutes);
			if (avgMinutes < 60) return $"{avgMinutes:F0}m";
			return $"{avgMinutes / 60:F1}h";
		}
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var ticketsTask = ApiClient.GetAllTicketsAsync();
			var outagesTask = ApiClient.GetRecentOutagesAsync();
			
			await Task.WhenAll(ticketsTask, outagesTask);
			
			tickets = await ticketsTask;
			outages = await outagesTask;
			
			ProcessTicketData();
		}
		finally
		{
			isLoading = false;
		}
	}

	private void ProcessTicketData()
	{
		// High priority tickets
		highPriorityTickets = tickets.Items
			.Where(t => t.Priority == "High" && t.Status != "Resolved" && t.Status != "Closed")
			.OrderByDescending(t => t.OpenedAt)
			.ToList();

		// Timeline: tickets created per day for last 7 days
		var today = DateTime.Today;
		ticketTimeline = Enumerable.Range(0, 7)
			.Select(offset =>
			{
				var date = today.AddDays(-6 + offset);
				var count = tickets.Items.Count(t => t.OpenedAt.Date == date);
				return new TimelinePoint(date.ToString("MMM d"), count);
			})
			.ToList();

		// Priority distribution
		priorityDistribution = tickets.Items
			.GroupBy(t => t.Priority)
			.Select(g => new PriorityPoint(g.Key, g.Count()))
			.OrderByDescending(p => GetPriorityOrder(p.Priority))
			.ToList();

		// Status breakdown
		statusBreakdown = tickets.Items
			.GroupBy(t => t.Status)
			.Select(g => new StatusPoint(g.Key, g.Count()))
			.OrderByDescending(s => s.Count)
			.ToList();
	}

	private int GetPriorityOrder(string priority) => priority switch
	{
		"High" => 3,
		"Medium" => 2,
		"Low" => 1,
		_ => 0
	};

	private BadgeStyle GetStatusBadgeStyle(string status) => status switch
	{
		"Open" => BadgeStyle.Warning,
		"InProgress" => BadgeStyle.Info,
		"Resolved" => BadgeStyle.Success,
		"Closed" => BadgeStyle.Secondary,
		_ => BadgeStyle.Light
	};

	private BadgeStyle GetPriorityBadgeStyle(string priority) => priority switch
	{
		"High" => BadgeStyle.Danger,
		"Medium" => BadgeStyle.Warning,
		"Low" => BadgeStyle.Success,
		_ => BadgeStyle.Secondary
	};

	private record TimelinePoint(string Date, int Count);
	private record PriorityPoint(string Priority, int Count);
	private record StatusPoint(string Status, int Count);
}
