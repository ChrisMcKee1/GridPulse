@page "/"
@using GridPulse.Web.Services.Models
@inject GridPulse.Web.Services.GridPulseApiClient ApiClient

<PageTitle>GridPulse</PageTitle>

<section class="page intro">
	<h1>Outage pulse</h1>
	<p>View the most recent outage activity captured by the GridPulse API.</p>
</section>

@if (isLoading)
{
	<p>Loading outage data...</p>
}
else if (outages.Count == 0)
{
	<p>No outages have been reported yet.</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Outage</th>
				<th>Status</th>
				<th>Reported</th>
				<th>ETA</th>
				<th>Affected</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var outage in outages)
			{
				<tr>
					<td>@outage.ServiceAddress</td>
					<td>@outage.Status</td>
					<td>@outage.ReportedAt.ToLocalTime().ToString("g")</td>
					<td>@(outage.EstimatedRestoration?.ToLocalTime().ToString("t") ?? "--")</td>
					<td>@outage.AffectedCustomers</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	private IReadOnlyList<OutageSummaryResponse> outages = Array.Empty<OutageSummaryResponse>();
	private bool isLoading = true;

	protected override async Task OnInitializedAsync()
	{
		outages = await ApiClient.GetRecentOutagesAsync();
		isLoading = false;
	}
}
