@using GridPulse.Application.Models
@using GridPulse.Domain.Enums

<RadzenStack Gap="12px">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H4">Timeline</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="tickets-subtitle">Most recent events first</RadzenText>
        </div>
        <RadzenBadge Text="@Events.Count.ToString()" BadgeStyle="BadgeStyle.Secondary" />
    </RadzenStack>

        @if (Events.Count == 0)
        {
            <RadzenAlert Severity="Severity.Info" Text="No timeline entries yet." />
        }
        else
        {
        <RadzenStack Gap="8px" data-testid="ticket-timeline">
            @foreach (var item in OrderedEvents)
            {
                var variant = GetVariant(item.EventType);
                <RadzenCard Style="padding: 16px; background-color: var(--rz-base-200); border: 1px solid var(--rz-base-400);">
                    <RadzenStack Gap="8px">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <StatusChip Label="@GetEventTitle(item)" Variant="@variant" />
                                <RadzenText TextStyle="TextStyle.Caption">@item.OccurredAt.ToLocalTime().ToString("g")</RadzenText>
                            </RadzenStack>
                            <RadzenStack Gap="4px">
                                <RadzenText TextStyle="TextStyle.Body2" Class="ticket-timeline-item__actor">@item.Actor</RadzenText>
                                @if (item.Details?.Count > 0)
                                {
                                    <RadzenStack Gap="4px" Style="margin-top: 4px;">
                                        @foreach (var detail in item.Details)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="4px">
                                                <RadzenText TextStyle="TextStyle.Subtitle2">@detail.Key:</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2">@detail.Value</RadzenText>
                                            </RadzenStack>
                                        }
                                    </RadzenStack>
                                }
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

@code
{
    [Parameter]
    public IReadOnlyCollection<AssignmentEventDto> Events { get; set; } = Array.Empty<AssignmentEventDto>();

    private IEnumerable<AssignmentEventDto> OrderedEvents => Events
        .OrderByDescending(evt => evt.OccurredAt);

    private static string GetEventTitle(AssignmentEventDto evt) => evt.EventType switch
    {
        AssignmentEventType.TicketDuplicateFlag => "Potential duplicate",
        AssignmentEventType.TicketCreated => "Ticket created",
        AssignmentEventType.TicketEdited => "Ticket updated",
        AssignmentEventType.RecommendationGenerated => "Recommendation generated",
        AssignmentEventType.AssignmentPublished => "Assignment published",
        AssignmentEventType.CrewAcknowledged => "Crew acknowledged",
        AssignmentEventType.CrewEnRoute => "Crew en route",
        AssignmentEventType.CrewOnScene => "Crew on scene",
        AssignmentEventType.CrewPaused => "Crew paused",
        AssignmentEventType.CrewCompleted => "Crew completed",
        AssignmentEventType.OperatorClosed => "Operator closed",
        AssignmentEventType.TicketCancelled => "Ticket cancelled",
        _ => evt.EventType.ToString()
    };

    private static string GetVariant(AssignmentEventType eventType) => eventType switch
    {
        AssignmentEventType.TicketDuplicateFlag => "warning",
        AssignmentEventType.CrewCompleted or AssignmentEventType.OperatorClosed => "success",
        AssignmentEventType.CrewAcknowledged or AssignmentEventType.CrewEnRoute or AssignmentEventType.CrewOnScene => "info",
        AssignmentEventType.TicketCancelled => "danger",
        _ => "default"
    };
}