@using GridPulse.Web.Components.Organisms.Models

<RadzenCard>
    <h4>Latest activity</h4>
    <ul class="activity-list">
        @foreach (var item in Items)
        {
            <li class="timeline-item">
                <div class="timeline-item__meta">@item.Timestamp.ToLocalTime().ToString("g")</div>
                <strong>@item.Title</strong>
                <p>@item.Description</p>
                <StatusChip Label="@item.StatusVariant" Variant="@item.StatusVariant.ToLowerInvariant()" />
            </li>
        }
    </ul>
</RadzenCard>

@code {
    [Parameter] public IReadOnlyList<OutageActivityItem> Items { get; set; } = Array.Empty<OutageActivityItem>();
}
